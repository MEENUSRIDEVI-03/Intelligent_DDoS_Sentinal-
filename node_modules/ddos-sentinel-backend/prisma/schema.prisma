generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  username  String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trafficLogs TrafficLog[]
  activityLogs ActivityLog[]

  @@index([email])
  @@index([username])
}

enum Role {
  USER
  ADMIN
}

model TrafficLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceIp        String
  destinationIp   String
  port            Int
  protocol        String
  packetCount     Int
  byteCount       Int
  flag            String?
  requestType     String?
  severity        String   @default("normal")
  timestamp       DateTime @default(now())
  isBlocked       Boolean  @default(false)

  @@index([userId])
  @@index([sourceIp])
  @@index([timestamp])
  @@index([severity])
}

model Prediction {
  id              String   @id @default(uuid())
  trafficLogId    String?
  prediction      String   // "normal", "suspicious", "high_risk", "ddos_attack"
  confidence      Float
  modelVersion    String
  timestamp       DateTime @default(now())

  @@index([prediction])
  @@index([timestamp])
}

model Alert {
  id              String   @id @default(uuid())
  title           String
  description     String
  severity        String   // "low", "medium", "high", "critical"
  status          String   @default("active") // "active", "acknowledged", "resolved"
  trafficLogId    String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  incidents       Incident[]

  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model Incident {
  id              String   @id @default(uuid())
  alertId         String
  alert           Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  description     String
  status          String   @default("open") // "open", "investigating", "resolved"
  resolution      String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([alertId])
  @@index([status])
}

model Report {
  id              String   @id @default(uuid())
  title           String
  description     String?
  type            String   // "traffic_summary", "security_analysis", "daily_report"
  data            Json
  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  @@index([type])
  @@index([createdAt])
}

model ActivityLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action          String
  description     String?
  resourceType    String?
  resourceId      String?
  timestamp       DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

model Settings {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt
}
